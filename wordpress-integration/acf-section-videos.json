[
  {
    "key": "group_egc_section_videos",
    "title": "Accueil - Section vidéos (sous le hero)",
    "fields": [
      {
        "key": "field_egc_section_videos",
        "label": "Section vidéos",
        "name": "section_videos",
        "type": "group",
