        "layout": "block",
        "sub_fields": [
          {
            "key": "field_egc_section_videos_titre",
            "label": "Titre",
            "name": "titre",
            "type": "text",
            "default_value": "Nos vidéos"
          },
          {
            "key": "field_egc_section_videos_sous_titre",
            "label": "Sous-titre",
            "name": "sous-titre",
            "type": "text"
          },
          {
            "key": "field_egc_section_videos_cta",
            "label": "CTA",
            "name": "cta",
            "type": "group",
            "layout": "table",
            "sub_fields": [
              {
                "key": "field_egc_section_videos_cta_libelle",
                "label": "Libellé",
                "name": "libelle",
                "type": "text",
                "instructions": "Si vide, le titre du lien est utilisé."
              },
              {
                "key": "field_egc_section_videos_cta_lien",
                "label": "Lien",
                "name": "lien",
                "type": "link",
                "return_format": "array"
              }
            ]
          },
          {
            "key": "field_egc_section_videos_videos",
            "label": "Vidéos",
