            "sub_fields": [
              {
                "key": "field_egc_section_videos_item_titre",
                "label": "Titre de la vidéo",
                "name": "titre",
                "type": "text",
                "instructions": "Affiché sous la vidéo (optionnel)."
              },
              {
                "key": "field_egc_section_videos_item_video",
                "label": "Vidéo",
                "name": "video",
                "type": "oembed",
                "required": 1,
                "instructions": "Collez l'URL YouTube, Vimeo, etc.",
                "width": "",
                "height": ""
              },
              {
                "key": "field_egc_section_videos_item_format",
                "label": "Format",
                "name": "format",
                "type": "select",
                "choices": {
                  "paysage": "Paysage (16/9)",
                  "portrait": "Portrait (9/16, short)"
